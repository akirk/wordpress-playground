{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/admin.php?page=playground-welcome",
	"steps": [
		{
			"step": "mkdir",
			"path": "/wordpress/wp-content/plugins/playground-welcome"
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/playground-welcome/playground-welcome.php",
			"data": {
				"resource": "url",
				"url": "../plugins/playground-welcome/playground-welcome.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/playground-welcome/playground-welcome.css",
			"data": {
				"resource": "url",
				"url": "../plugins/playground-welcome/playground-welcome.css"
			}
		},
		{
			"step": "activatePlugin",
			"pluginPath": "playground-welcome/playground-welcome.php"
		}
	]
}
